# 간단한 계산기 함수
def calc(a, b, op):
    if op == "+":
        return a + b
    elif op == "-":
        return a - b
    elif op == "*":
        return a * b
    elif op == "/":
        return a / b
    else:
        return "잘못된 연산자입니다."

x = int(input("첫 번째 수: "))
y = int(input("두 번째 수: "))
op = input("연산자 (+, -, *, /): ")
print("결과:", calc(x, y, op))
# 랜덤 퀴즈 게임
import random

score = 0

questions = {
    "파이썬에서 문장을 출력할 때 사용하는 함수는?": "print",
    "파이썬에서 리스트의 첫 번째 요소의 인덱스는?": "0",
    "정수 나눗셈 기호는?": "//",
}

print("나도 프로그래머 퀴즈에 오신 걸 환영합니다!")
print("-" * 30)

for q in random.sample(list(questions.keys()), 3):
    answer = input(q + " ")
    if answer.strip().lower() == questions[q].lower():
        print("정답입니다!")
        score += 1
    else:
        print("틀렸어요! 정답은", questions[q])

print(f"총 점수는 {score}/3점입니다.")
